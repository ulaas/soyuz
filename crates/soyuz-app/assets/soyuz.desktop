[Desktop Entry]
Type=Application
Version=1.5
Name=Soyuz
GenericName=File Manager
Comment=Keyboard-first, non-blocking file explorer
Exec=soyuz %U
TryExec=soyuz
Icon=soyuz
Terminal=false
StartupNotify=true
StartupWMClass=soyuz
Categories=System;FileTools;FileManager;Core;
MimeType=inode/directory;
Keywords=files;folders;explorer;file manager;browser;directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=soyuz --new-window
