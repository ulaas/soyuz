# Pinned inputs of the FFmpeg runtime Soyuz builds in CI (scripts/ffmpeg-build.sh, Phase V1b).
# Shell syntax (`source third_party/ffmpeg/pins.env`); one URL and one SHA-256 per input.
# Bumping a pin: new version + URL, download, `sha256sum`, update README.md's table, and
# let CI rebuild (the actions/cache key hashes this file). Keep FFmpeg on the newest point
# release of its line: point releases are mostly security fixes for demuxers and decoders
# that run on untrusted files.
#
# Sums recorded 2026-10-14 from the files downloaded at these URLs (re-verified by V1b the same day). The FFmpeg tarball is
# also signed (`.asc`, FFmpeg release key); the build script verifies the signature when
# `gpg` is available and the sum always.

# FFmpeg 9.0 line: avutil 61, swresample 7, swscale 10, avcodec 63, avformat 63 (LGPL-2.1-or-later).
# FFMPEG_MAJORS names the five library majors in load order (avutil swresample swscale
# avcodec avformat); the build script derives the file names from it and fails when the
# install does not produce them, so a bump to a new major is noticed here first (then
# crates/soyuz-media/src/sys/layout.rs needs a table and CI a leg).
FFMPEG_VERSION=9.0.2
FFMPEG_MAJORS="61 7 10 63 63"
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_ASC_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_ASC_SHA256=d617fd94ea354dadd2a8bb16243d37c44e1e9729b06b6ad58fe30bfb0fa943f2

# dav1d: the AV1 software decoder (BSD-2-Clause); FFmpeg's own `av1` decoder is hwaccel-only.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5

# libopus: Opus encoder (BSD-3-Clause); FFmpeg's native Opus encoder is experimental.
OPUS_VERSION=1.5.2
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1

# libvpx: VP8 / VP9 encoders (BSD-3-Clause). GitHub tag archive; re-pin if GitHub regenerates it.
LIBVPX_VERSION=1.17.0
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz
LIBVPX_SHA256=1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a

# Header-only hardware encoder SDKs (no code of theirs ends up in the libraries).
# nv-codec-headers (ffnvcodec, MIT): NVENC / NVDEC / CUDA on Windows and Linux.
NVCODEC_VERSION=13.1.15.0
NVCODEC_URL=https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n13.1.15.0.tar.gz
NVCODEC_SHA256=2255bc74d038b95aa4be30f5f66322c2176acbdb90ada1851db6993536fbeaf7

# AMD AMF (MIT): h264_amf / hevc_amf / av1_amf on Windows. The tag archive is a few
# hundred MB (samples and binaries) and only amf/public/include is needed, so there is no
# archive sum: the build script makes a sparse, blobless clone of tag v<AMF_VERSION>
# (`git clone --depth 1 --filter=blob:none --sparse` + `git sparse-checkout set
# amf/public/include`) and refuses it unless HEAD is exactly AMF_COMMIT (the tag's commit,
# read from the GitHub API on 2026-10-22; the commit id covers the whole tree). The headers
# are archived as AMF-headers-<commit>.tar.gz for SOURCES.txt and the runtime release.
AMF_VERSION=1.5.3
AMF_GIT=https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git
AMF_COMMIT=57ee0cfb0e1a08d9041f77435653794c1b012be0

# Intel libvpl (MIT): h264_qsv / hevc_qsv / av1_qsv on Windows (the dispatcher loads the
# driver's runtime at run time). GitHub tag archive.
LIBVPL_VERSION=2.17.0
LIBVPL_URL=https://github.com/intel/libvpl/archive/refs/tags/v2.17.0.tar.gz
LIBVPL_SHA256=4de3e2faf1e8307fb282e4a43f443191810f6a6b0a484fffa7995ba1c814c6ec
