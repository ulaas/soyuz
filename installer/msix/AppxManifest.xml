<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Soyuz (a full-trust Win32 desktop app). Built by
  installer/msix/build-msix.ps1, which fills in the version and copies soyuz.exe,
  soyuz-tui.exe, the
  licenses and generated logo PNGs next to this file before running makeappx.

  @VERSION@ is the 4-part package version (x.y.z.0); @PUBLISHER@ must equal the Subject of
  the signing certificate (signtool sign /fd SHA256 /f cert.pfx soyuz.msix). Unsigned
  packages only install with Developer Mode + Add-AppxPackage -AllowUnsigned (Windows 11).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop desktop4 rescap">

  <Identity Name="Soyuz.FileExplorer"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Soyuz</DisplayName>
    <PublisherDisplayName>The Soyuz contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A keyboard-first, non-blocking file explorer.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Soyuz" Executable="soyuz.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Soyuz"
        Description="Keyboard-first file explorer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- `soyuz C:\some\folder` from any terminal. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="soyuz.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="soyuz.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
    <!-- The terminal UI (`soyuz-tui C:\some\folder`): a console-subsystem exe, so its alias
         is declared as a console app and runs inside the terminal that typed it. Not in
         the Start menu (AppListEntry="none"). -->
    <Application Id="SoyuzTui" Executable="soyuz-tui.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Soyuz terminal UI"
        Description="Soyuz in the terminal"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="soyuz-tui.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="soyuz-tui.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
